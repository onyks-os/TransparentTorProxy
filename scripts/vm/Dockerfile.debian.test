# TTP Integration Test Environment
# Pinned by digest. These images decide which nftables and kernel headers the
# integration suite runs against, so a moving tag silently changes the
# environment a passing test was measured in. Bump deliberately.
FROM docker.io/library/debian:13-slim@sha256:abc9cb88a5587630d7f915f47b23b0668fe250fbfc6457aa4d52b534c1bbf73f

ENV container docker

# Install systemd, python, tor, nftables, curl
RUN apt-get update && apt-get install -y \
    systemd systemd-sysv \
    python3 python3-pip python3-venv \
    nftables tor procps curl iptables kmod iproute2 \
    libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

# Mask services that often fail in unprivileged or standard containers
RUN systemctl mask systemd-udevd.service \
                   systemd-udevd-kernel.socket \
                   systemd-udevd-control.socket \
                   systemd-modules-load.service \
                   sys-kernel-debug.mount \
                   sys-kernel-tracing.mount

# Set up virtual environment
RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"

COPY . /app
WORKDIR /app

# Install TTP with dev dependencies, NSE, and pyroute2 (netlink route setup without /sys mount)
RUN pip install -e ".[dev,nse]"

STOPSIGNAL SIGRTMIN+3

CMD ["/lib/systemd/systemd"]
