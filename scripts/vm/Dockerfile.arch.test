# TTP Integration Test Environment (Arch Linux)
# Pinned by digest. These images decide which nftables and kernel headers the
# integration suite runs against, so a moving tag silently changes the
# environment a passing test was measured in. Bump deliberately.
FROM docker.io/library/archlinux:latest@sha256:522dd24e4a16f41afe71c7561febe519f7575404c291565e9f0be823d1794ca4

ENV container docker

# Initialize pacman keys and install dependencies
RUN pacman-key --init && pacman-key --populate archlinux && \
    pacman -Syu --noconfirm && \
    pacman -S --noconfirm systemd python python-pip nftables tor procps-ng curl iptables iproute2 base-devel libpcap \
    && pacman -Scc --noconfirm

# Arch uses systemd by default, mask troublesome services
RUN systemctl mask systemd-udevd.service \
                   systemd-udevd-kernel.socket \
                   systemd-udevd-control.socket \
                   systemd-modules-load.service \
                   sys-kernel-debug.mount \
                   sys-kernel-tracing.mount

# Set up virtual environment
RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"

COPY . /app
WORKDIR /app

# Install TTP with dev dependencies, NSE, and pyroute2 (netlink route setup without /sys mount)
RUN pip install -e ".[dev,nse]"

STOPSIGNAL SIGRTMIN+3

CMD ["/usr/lib/systemd/systemd"]
