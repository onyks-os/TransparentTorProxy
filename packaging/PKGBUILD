# TTP - Arch Linux PKGBUILD
#
# This file tells makepkg how to build a native Arch Linux package
# (.pkg.tar.zst) from the TTP source code.
#
# Unlike .deb and .rpm, Arch uses a single-file format (PKGBUILD)
# that defines everything: metadata, dependencies, build steps, and
# file installation. The build is run via `makepkg` which reads this
# file, calls build() and package(), and produces the final archive.
#
# For AUR (Arch User Repository) submission, this file would be placed
# in its own git repo alongside a .SRCINFO file generated by
# `makepkg --printsrcinfo`.
#
# Usage (local build):
#   cd packaging && makepkg -si
#
# Usage (AUR):
#   Upload PKGBUILD + .SRCINFO to aur.archlinux.org

# Define the package name as it will appear in the Arch package manager (pacman).
pkgname=transparent-tor-proxy

# The version of the software. This should match the version in pyproject.toml.
pkgver=0.4.9

# The release number. If you update the PKGBUILD but the software version (x.y.z) 
# hasn't changed, you increment this to tell users to update the package.
pkgrel=1

# A short description of what the software does.
pkgdesc="A Linux CLI tool that transparently routes all system traffic through the Tor network"

# The target architecture. 'any' means it's Python/script-based and works on x86_64, ARM, etc.
arch=('any')

# The project's homepage or repository URL.
url="https://github.com/onyks-os/TransparentTorProxy"

# The license under which the software is released.
license=('MIT')

# Runtime dependencies. Pacman will ensure these are installed before TTP runs.
# Notice how Arch package names differ slightly from Debian (e.g., 'python-typer' instead of 'python3-typer').
# python-six is for the bundled transitions below.
depends=('python' 'python-typer' 'python-rich' 'python-stem' 'python-six' 'nftables' 'tor')

# Build dependencies. These are only needed temporarily while creating the package.
# python-hatchling is the build backend; with --no-isolation it must be installed.
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')

# Where to get the source code. TTP itself is not a source entry: this PKGBUILD
# lives in the repository and builds the checkout it sits in, "$startdir/..".
# It used to list that directory as "local-source::..", which makepkg rejects
# ("local-source was not found in the build directory"), so the documented
# `cd packaging && makepkg -si` could not build anything.
#
# Arch has `transitions` only in the AUR, so it is bundled into a private
# directory that ttp falls back to (ttp/watchdog/fsm.py, VENDOR_DIR). Same
# version and digest as packaging/bundled-transitions.env.
_transitions_whl=transitions-0.9.3-py2.py3-none-any.whl
source=("https://files.pythonhosted.org/packages/f4/05/fea3020e90aa378941ff10de8860fb3b1288313c27efd10fa0c476498f7e/${_transitions_whl}")
noextract=("${_transitions_whl}")

# Checksums to verify source file integrity.
sha256sums=('02463248f2b668d86f66636b1e3c9e8de84d93e22915247f4e1aa9ee1cae28aa')

# The build() function is run first. Its job is to compile the code.
build() {
    # Move into the repository checkout this PKGBUILD belongs to.
    cd "$startdir/.."

    # Use standard Python tools to build a 'wheel' (.whl) package, into $srcdir
    # so that nothing is written to the checkout.
    # --no-isolation tells it to use the system's python-build dependencies (listed in makedepends)
    # rather than downloading them in a temporary virtual environment. So this build uses Arch's
    # hatchling, not the hash-pinned one in build-requirements.txt that the released .deb, .rpm
    # and wheel are built with; that is the normal contract for a distribution package.
    python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

# The package() function is run next. Its job is to take the compiled files 
# and place them into a fake root directory ($pkgdir) exactly as they should appear on the real system.
package() {
    cd "$startdir/.."

    # Use python-installer to extract the wheel built in the previous step
    # and place its contents (the Python code and the 'ttp' executable command) into $pkgdir.
    python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
    
    # Install systemd service
    # install -D creates necessary parent directories. -m644 sets permissions (read/write for owner, read for others).
    # It copies the local ttp.service to the correct systemd directory inside the package.
    install -Dm644 packaging/ttp.service "$pkgdir/usr/lib/systemd/system/ttp.service"

    # Install sysusers config
    install -Dm644 packaging/transparent-tor-proxy.sysusers "$pkgdir/usr/lib/sysusers.d/transparent-tor-proxy.conf"

    # Install Polkit rules
    install -Dm644 ttp/resources/polkit/50-ttp-watchdog.rules "$pkgdir/usr/share/polkit-1/rules.d/50-ttp-watchdog.rules"
    
    # The bundled transitions, where ttp falls back to it.
    install -d "$pkgdir/usr/lib/transparent-tor-proxy/vendor"
    bsdtar -xf "$srcdir/${_transitions_whl}" -C "$pkgdir/usr/lib/transparent-tor-proxy/vendor"

    # Install the license file (required by Arch Linux standards for MIT).
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
