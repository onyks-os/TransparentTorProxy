#
# The copy of `transitions` that the .rpm and the PKGBUILD bundle, because
# Fedora does not package it and Arch has it only in the AUR. The .deb depends on
# Debian's python3-transitions instead. Sourced by build_rpm.sh; PKGBUILD repeats
# the values literally, and tests/test_packaging_dependencies.py keeps the two in
# step. Installed into /usr/lib/transparent-tor-proxy/vendor, which
# ttp.watchdog.fsm falls back to only when the system has no `transitions`.
#
# Changing the version means changing all four values: the digest is the one
# PyPI publishes for that exact wheel, and the build refuses any other.
TRANSITIONS_VERSION=0.9.3
TRANSITIONS_WHEEL=transitions-0.9.3-py2.py3-none-any.whl
TRANSITIONS_URL=https://files.pythonhosted.org/packages/f4/05/fea3020e90aa378941ff10de8860fb3b1288313c27efd10fa0c476498f7e/transitions-0.9.3-py2.py3-none-any.whl
TRANSITIONS_SHA256=02463248f2b668d86f66636b1e3c9e8de84d93e22915247f4e1aa9ee1cae28aa
