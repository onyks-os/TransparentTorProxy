# Dedicated named policy: no executable attachment and no unconfined fallback.
#include <tunables/global>
profile ttp-tor flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  unix,
  signal,
  /usr/{,local/}{bin,sbin}/tor rix,
  /usr/{,local/}{bin,sbin}/{obfs4proxy,snowflake-client,lyrebird} rix,
  /usr/share/tor/{,**} r,
  /etc/tor/{,**} r,
  /proc/sys/net/core/somaxconn r,
  /proc/sys/kernel/random/uuid r,
  /sys/devices/system/cpu/{,**} r,
  /var/lib/tor/ r,
  owner /var/lib/tor/ttp/{,**} rwk,
  /{,var/}run/tor/ r,
  owner /{,var/}run/tor/ttp/{,**} rwk,
  /{,var/}run/systemd/notify w,
  /systemd/notify w,
  /systemd/journal/dev-log w,
}
