# Normalize line endings on checkin; check out native on each platform.
* text=auto eol=lf

# Shell scripts must keep LF endings or they break on Linux.
*.sh    text eol=lf
*.bash  text eol=lf
Makefile text eol=lf
*.mk    text eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Treat these as binary — never diff or merge them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.xz    binary
*.qcow2 binary
*.iso   binary

# Exclude non-shipping paths from GitHub language statistics and archives.
docs/**       linguist-documentation
tests/**      linguist-vendored=false
.github/**    export-ignore
tests/**      export-ignore
docs/**       export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
